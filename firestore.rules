rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'Minombreesmcfly@gmail.com' ||
          request.auth.token.email == 'minombreesmcfly@gmail.com' ||
          request.auth.token.email.lower() == 'minombreesmcfly@gmail.com' ||
          request.auth.token.email.lower() == 'macfly@gmail.com'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid']) &&
             data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow get, list: if true; // Publicly list artists/profiles
      
      allow create: if isSignedIn() && (isAdmin() || userId == request.auth.uid);
      
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.uid == resource.data.uid);
      
      allow delete: if isAdmin();
    }

    // Redemptions Validation
    function isValidRedemption(data) {
      return data.keys().hasAll(['userId', 'rewardTitle', 'pointsSpent']) &&
             data.userId == request.auth.uid &&
             data.rewardTitle is string && data.rewardTitle.size() <= 200 &&
             data.pointsSpent is number && data.pointsSpent >= 0 &&
             (!('status' in data) || data.status in ['pending', 'claimed', 'contacted', 'completed', 'rejected']) &&
             (!('userEmail' in data) || data.userEmail is string) &&
             (!('userDisplayName' in data) || data.userDisplayName is string) &&
             (!('claimedAt' in data) || data.claimedAt is string) &&
             (!('createdAt' in data) || data.createdAt is string);
    }

    match /redemptions/{redemptionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidRedemption(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Track Validation
    function isValidTrack(data) {
      return data.keys().hasAll(['artistId', 'title', 'audioUrl']) &&
             data.artistId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.audioUrl is string && data.audioUrl.size() <= 1000;
    }

    match /tracks/{trackId} {
      allow read: if true; // Public radio/music
      
      allow create: if (isSignedIn() && isValidTrack(request.resource.data) && (
        // Must be an artist to upload music
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'artist' ||
        isAdmin()
      ));
      
      allow update: if isAdmin() || (isSignedIn() && resource.data.artistId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.artistId == request.auth.uid);
    }

    // News/Events Validation
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Config documents (spotify, cloudinary, sponsorships)
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Career boost requests
    match /careerBoostRequests/{reqId} {
      allow read, write: if true;
    }

    // Beats collection
    match /beats/{beatId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Videos collection
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
